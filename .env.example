# HIMARI Signal Layer - Environment Variables
# Copy this to .env and fill in your API keys
# NEVER commit .env to git!

# =============================================
# INFRASTRUCTURE
# =============================================
KAFKA_BOOTSTRAP=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================
# FREE API KEYS (Get these from respective sites)
# =============================================

# Polygon.io - https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_key_here

# Etherscan - https://etherscan.io/register
ETHERSCAN_API_KEY=your_etherscan_key_here

# CoinGecko Pro (optional) - https://www.coingecko.com/api/pricing
COINGECKO_API_KEY=

# NewsData.io - https://newsdata.io/register
NEWSDATA_API_KEY=

# Finnhub - https://finnhub.io/register
FINNHUB_API_KEY=

# =============================================
# NO API KEY NEEDED (FREE UNLIMITED)
# =============================================
# - Binance WebSocket (OHLCV, Order Book, Ticks)
# - CoinCap
# - Reddit (read-only JSON endpoints)
