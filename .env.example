# HIMARI L1 Signal Layer - Environment Configuration
# Copy to .env and update with your actual infrastructure endpoints

# ============================================================================
# REDIS - Feature Store (from HIMARI-OPUS-DATA-INFRASTRUCTURE)
# ============================================================================
# If running locally with docker-compose:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DB=0

# For Hetzner deployment (update with your server IP):
# REDIS_HOST=<himari-timescale-ip>
# REDIS_PORT=6379
# REDIS_PASSWORD=<your-redis-password>

# ============================================================================
# KAFKA/REDPANDA - Message Broker (from HIMARI-OPUS-DATA-INFRASTRUCTURE)
# ============================================================================
# If running locally with docker-compose:
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_CONSUMER_GROUP=himari-l1-signals
KAFKA_INPUT_TOPIC=quality_scores
KAFKA_OUTPUT_TOPIC=l1_signals

# For Hetzner deployment (update with your server IP):
# KAFKA_BOOTSTRAP=<himari-redpanda-ip>:9092

# ============================================================================
# SYMBOLS TO PROCESS
# ============================================================================
# Comma-separated list of trading pairs
HIMARI_SYMBOLS=BTCUSDT,ETHUSDT

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_GARCH=true
ENABLE_HMM=true
ENABLE_HURST=true
ENABLE_ENTROPY=true
ENABLE_OBI=true

# ============================================================================
# VALIDATION
# ============================================================================
SHARPE_HURDLE=3.0
DSR_CONFIDENCE=0.95
