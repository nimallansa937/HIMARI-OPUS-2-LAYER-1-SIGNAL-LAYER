# HIMARI SRM Environment Variables

# Redis connection
SRM_REDIS_URL=redis://localhost:6379

# Symbols to monitor (comma-separated)
SRM_SYMBOLS=BTCUSDT,ETHUSDT

# Dry-run mode (set to false for live trading)
SRM_DRY_RUN=true

# CoinGlass API key (optional, enables multi-venue LCI)
COINGLASS_API_KEY=

# Telegram notifications (optional)
SRM_TELEGRAM_BOT_TOKEN=
SRM_TELEGRAM_CHAT_ID=

# Binance Futures API (required for emergency exits in live mode)
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# Logging
LOG_LEVEL=INFO
